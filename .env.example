# ============================================
# MyShop - Arquivo de Exemplo de Variáveis
# ============================================
# Copie este arquivo para .env e preencha os valores

# ============================================
# DATABASE - PostgreSQL
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=myshop
POSTGRES_HOST=localhost
DB_PORT=5432

# ============================================
# AUTHENTICATION - JWT
# ============================================
# Gere uma chave segura aleatória para JWT
# Exemplo: openssl rand -base64 32
JWT_SECRET=sua-chave-secreta-muito-segura-aqui

# ============================================
# EMAIL - Gmail SMTP
# ============================================
# Configure com sua conta Gmail
# Crie uma "App Password" em myaccount.google.com
# Settings > Security > App passwords > Mail > Other (custom name)
EMAIL_USE=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app-gmail

# ============================================
# FRONTEND - URLs
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# RATE LIMITING - Upstash Redis
# ============================================
# Crie uma conta em https://upstash.com
# Redis Console > Create Database > Copy Rest Endpoint & Token
UPSTASH_REDIS_REST_URL=https://seu-url-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token-upstash

# ============================================
# ENVIRONMENT - Node.js
# ============================================
# Valores: development, production, test
NODE_ENV=development

# ============================================
# DEPLOYMENT - Vercel (Opcional)
# ============================================
# VERCEL_ENV=production
# VERCEL_URL=https://seu-projeto.vercel.app
