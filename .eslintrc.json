{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "node": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:jest/recommended",
    "next",
    "next/core-web-vitals",
    "prettier"
  ],
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "coverage/**",
    "package*.json",
    "migrations/**",
    "infra/**"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["infra/**/*.js", "test/**/*.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
