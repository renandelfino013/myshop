{
  "name": "myshop",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run services:up&&npm run wait-for-postgres  && npm run migrate:up && next dev",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.js",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down -v ",
    "services:stop": "docker compose -f infra/compose.yaml stop ",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "build": "next build",
    "start": "next start",
    "postinstall": "npm rebuild bcrypt --build-from-source",
  "test": "npm run services:up && npm run wait-for-postgres && npm run migrate:up&& concurrently -n next,jest -k --success command-jest --hide next \"next dev\" \"jest --runInBand --detectOpenHandles --verbose\"",
    "test:watch": "jest --watchAll --runInBand",
    "migrate:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrate:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env  up",
    "migrate:down": "node-pg-migrate --migrations-dir infra/migrations --envPath .env down"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "hash": "^0.2.1",
    "jest": "^30.4.2",
    "jsonwebtoken": "^9.0.3",
    "lottie-react": "^2.4.1",
    "next": "^14.2.3",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@types/jest": "^30.0.0",
    "async-retry": "^1.3.3",
    "babel-jest": "^30.4.1",
    "concurrently": "^10.0.3",
    "next-test-api-route-handler": "^5.0.5"
  }
}
