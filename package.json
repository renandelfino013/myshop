{
  "name": "myshop",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run services:up&&npm run wait-for-postgres  && npm run migrate:up && next dev",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.js",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down -v ",
    "services:stop": "docker compose -f infra/compose.yaml stop ",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "build": "next build",
    "start": "next start",
    "postinstall": "npm rebuild bcrypt --build-from-source",
    "test": "npm run services:up && npm run wait-for-postgres && npm run migrate:up && concurrently -n next,jest -k --success command-jest --hide next \"cross-env APP_ENV=test next dev\" \"jest --runInBand --detectOpenHandles --verbose\"",
    "test:watch": "jest --watchAll --runInBand",
    "migrate:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrate:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env  up",
    "migrate:down": "node-pg-migrate --migrations-dir infra/migrations --envPath .env down",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "dotenv-expand": "1000.0.0",
    "hash": "0.2.1",
    "jest": "30.4.2",
    "jsonwebtoken": "9.0.3",
    "lottie-react": "2.4.1",
    "next": "16.3.1",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "supertest": "7.2.2"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "8.57.1",
    "@types/jest": "30.0.0",
    "async-retry": "1.3.3",
    "babel-jest": "30.4.1",
    "commitizen": "4.3.2",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.1",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "next-test-api-route-handler": "5.0.6",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "allowScripts": {}
}
