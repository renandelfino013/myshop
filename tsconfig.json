{
  "compilerOptions": {
    "target": "ES2017",
    "paths": {
      "utils/*": ["./utils/*"],
      "styles/*": ["./styles/*"],
      "infra/*": ["./infra/*"],
      "schemas/*": ["./shared/schemas/*"],
      "shared/*": ["./shared/*"],
      "services/*": ["./services/*"],
      "front-services/*": ["./front-services/*"],
      "hooks/*": ["./hooks/*"],
      "test/*": ["./test/*"],
      "components/*": ["./components/*"],
      "models/*": ["./models/*"],
      "proxy/*": ["./proxy/*"],
      "variables/*": ["./shared/schemas/variables/*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["next-env.d.ts", "**/*.mts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
